<!-- Временный домашний экран после входа: чаты — следующий этап. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeowGram.ViewModels"
             xmlns:l="using:MeowGram.Localization"
             x:Class="MeowGram.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             x:CompileBindings="True">
  <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36">
    <StackPanel Spacing="12">
      <TextBlock Classes="display" Text="MeowGram" />
      <TextBlock Classes="title" Margin="0,20,0,0" Text="{l:Tr Home_Title}" />
      <TextBlock Classes="body" FontWeight="Medium" Text="{Binding AccountName}" />
      <TextBlock Classes="caption secondary" Text="{Binding Phone}" />
      <TextBlock Classes="body secondary" Margin="0,8,0,16" Text="{l:Tr Home_Subtitle}" />
      <Button Theme="{StaticResource Mg.SecondaryButton}" HorizontalAlignment="Stretch"
              Content="{l:Tr Home_AddAccount}" Command="{Binding AddAccountCommand}" />
      <Button Theme="{StaticResource Mg.LinkButton}" HorizontalAlignment="Center" Margin="0,6,0,0"
              Content="{l:Tr Home_LogOut}" Command="{Binding LogOutCommand}" IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
  </Border>
</UserControl>
