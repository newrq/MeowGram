<!--
  Список чатов (макет Main / States): заголовок папки, счётчик окон сплита, «новое сообщение», поле поиска
  (открывает поиск), строки чатов. Строку можно перетащить в центр — перетаскивание ведёт MessengerView.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeowGram.ViewModels.Messenger"
             xmlns:controls="using:MeowGram.Controls"
             xmlns:l="using:MeowGram.Localization"
             x:Class="MeowGram.Views.Messenger.ChatListPanel"
             x:DataType="vm:MessengerViewModel"
             x:CompileBindings="True">

  <UserControl.Styles>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowTime">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.MetaBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rowPreview">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.prefix">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.prefix.draft">
      <Setter Property="Foreground" Value="{DynamicResource Mg.ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.typing">
      <Setter Property="Foreground" Value="{DynamicResource Mg.AccentBrush}" />
    </Style>
    <Style Selector="Border.slot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Mg.InsetBrush}" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.slot TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.slot.active">
      <Setter Property="Background" Value="{DynamicResource Mg.AccentBrush}" />
    </Style>
    <Style Selector="Border.slot.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mg.OnAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Заголовок -->
    <Grid DockPanel.Dock="Top" Height="44" Margin="8,0,4,12" ColumnDefinitions="*,Auto,Auto">
      <TextBlock Classes="title" Text="{Binding ChatList.Title, FallbackValue=''}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="13"
                 Foreground="{DynamicResource Mg.MetaBrush}" Text="{Binding Split.OpenLabel, FallbackValue=''}" />
      <Button Grid.Column="2" Theme="{StaticResource Mg.FilledIconButton}" Command="{Binding NewMessageCommand}"
              ToolTip.Tip="{l:Tr Tip_NewMessage}" AutomationProperties.Name="{l:Tr Tip_NewMessage}">
        <controls:SvgIcon Source="avares://MeowGram/Assets/icons/pencil.svg" Width="18" Height="18" />
      </Button>
    </Grid>

    <!-- Поле поиска: кнопка, открывающая панель поиска -->
    <Button DockPanel.Dock="Top" Theme="{StaticResource Mg.SurfaceButton}" Height="44" Margin="0,0,0,12"
            CornerRadius="14" Background="{DynamicResource Mg.SurfaceBrush}" Padding="14,0,12,0"
            Foreground="{DynamicResource Mg.TextMutedBrush}" Command="{Binding OpenSearchCommand}"
            AutomationProperties.Name="{l:Tr Search_Placeholder}">
      <DockPanel>
        <controls:SvgIcon DockPanel.Dock="Left" Source="avares://MeowGram/Assets/icons/chat-search.svg" Width="18" Height="18" />
        <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Mg.LineBrush}" BorderThickness="1" CornerRadius="6"
                Padding="6,1" VerticalAlignment="Center">
          <TextBlock Text="Ctrl K" FontSize="11.5" Foreground="{DynamicResource Mg.MetaBrush}" />
        </Border>
        <TextBlock Margin="10,0" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"
                   Foreground="{DynamicResource Mg.MetaBrush}" Text="{l:Tr Search_Placeholder}" />
      </DockPanel>
    </Button>

    <!-- Строки -->
    <Panel>
      <ScrollViewer x:Name="Scroller" Margin="0,0,-4,0" Padding="0,0,4,0"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Rows" ItemsSource="{Binding ChatList.Rows, FallbackValue={x:Null}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ChatRowViewModel">
              <Button Theme="{StaticResource Mg.ChatRow}" Classes="chatRow" Margin="0,0,0,2"
                      Classes.open="{Binding IsOpen}" Classes.dragged="{Binding IsDragged}"
                      AutomationProperties.Name="{Binding Title}">
                <DockPanel>
                  <!-- Аватарка -->
                  <Panel DockPanel.Dock="Left" Width="50" Height="50" Margin="0,0,12,0">
                    <controls:Avatar Size="50" Initials="{Binding Initials}" Image="{Binding Photo}"
                                     Background="{Binding AvatarBackground}" ShowOnline="{Binding ShowOnline}"
                                     IsVisible="{Binding !IsSaved}" />
                    <Border IsVisible="{Binding IsSaved}" CornerRadius="25" Background="{DynamicResource Mg.AccentBrush}">
                      <controls:SvgIcon Source="avares://MeowGram/Assets/icons/bookmark.svg" Width="22" Height="22"
                                        Foreground="{DynamicResource Mg.OnAccentBrush}" />
                    </Border>
                  </Panel>

                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <!-- Строка 1: [канал] название [без звука] [галочки] время -->
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="rowTime" Text="{Binding Time}" />
                      <controls:SvgIcon DockPanel.Dock="Right" Source="avares://MeowGram/Assets/icons/status-read.svg"
                                        Width="16" Height="16" Margin="6,0,4,0" Foreground="{DynamicResource Mg.AccentBrush}"
                                        IsVisible="{Binding ShowRead}" />
                      <controls:SvgIcon DockPanel.Dock="Right" Source="avares://MeowGram/Assets/icons/status-sent.svg"
                                        Width="16" Height="16" Margin="6,0,4,0" Foreground="{DynamicResource Mg.TextMutedBrush}"
                                        IsVisible="{Binding ShowSent}" />
                      <controls:SvgIcon DockPanel.Dock="Right" Source="avares://MeowGram/Assets/icons/muted.svg"
                                        Width="14" Height="14" Margin="6,0,6,0" Foreground="{DynamicResource Mg.TextMutedBrush}"
                                        IsVisible="{Binding IsMuted}" />
                      <controls:SvgIcon DockPanel.Dock="Left" Source="avares://MeowGram/Assets/icons/channel.svg"
                                        Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource Mg.TextMutedBrush}"
                                        IsVisible="{Binding IsChannel}" />
                      <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                    </DockPanel>

                    <!-- Строка 2: превью и значки справа -->
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SvgIcon Source="avares://MeowGram/Assets/icons/pin.svg" Width="15" Height="15"
                                          Margin="8,0,0,0" Foreground="{DynamicResource Mg.TextMutedBrush}"
                                          IsVisible="{Binding ShowPin}" />
                        <controls:Badge Kind="Mention" Margin="6,0,0,0" IsVisible="{Binding HasMention}" />
                        <controls:Badge Kind="Accent" Margin="6,0,0,0" Text="{Binding UnreadText}"
                                        IsVisible="{Binding ShowUnreadAccent}" />
                        <controls:Badge Kind="Muted" Margin="6,0,0,0" Text="{Binding UnreadText}"
                                        IsVisible="{Binding ShowUnreadMuted}" />
                        <Border Classes="slot" Classes.active="{Binding IsActiveSlot}" IsVisible="{Binding IsOpen}">
                          <TextBlock Text="{Binding OpenSlot}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Classes="rowPreview typing" Text="{Binding TypingText}" IsVisible="{Binding IsTyping}" />
                      <DockPanel IsVisible="{Binding ShowPlainPreview}">
                        <controls:SvgIcon DockPanel.Dock="Left" Source="avares://MeowGram/Assets/icons/mic.svg"
                                          Width="15" Height="15" Margin="0,0,6,0"
                                          Foreground="{DynamicResource Mg.TextSecondaryBrush}"
                                          IsVisible="{Binding ShowVoiceIcon}" />
                        <TextBlock DockPanel.Dock="Left" Classes="rowPreview prefix" Classes.draft="{Binding IsDraft}"
                                   Text="{Binding PreviewPrefix}" IsVisible="{Binding HasPreviewPrefix}" />
                        <TextBlock Classes="rowPreview" Text="{Binding PreviewText}" />
                      </DockPanel>
                    </DockPanel>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="body secondary"
                 Text="{l:Tr Chats_Empty}" IsVisible="{Binding ChatList.IsEmpty, FallbackValue=False}" />
    </Panel>
  </DockPanel>
</UserControl>
