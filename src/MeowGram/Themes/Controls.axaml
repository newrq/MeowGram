<!--
  Оформление кнопок MeowGram (ControlTheme, без шаблонов Fluent):
  Mg.PrimaryButton — главное действие (акцент), Mg.SecondaryButton — второстепенное (на карточке),
  Mg.LinkButton — текстовая ссылка, Mg.RoundButton — круглая кнопка нижнего ряда экрана входа.
  Наведение — плавная смена фона, нажатие — сжатие до 97%.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MeowGram.Controls">

  <ControlTheme x:Key="Mg.ButtonBase" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Mg.FontBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.TextBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Mg.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mg.ButtonRadius}" />
    <Setter Property="Background" Value="{DynamicResource Mg.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.OnAccentBrush}" />
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Mg.AccentHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Mg.AccentPressedBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Mg.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mg.ButtonRadius}" />
    <Setter Property="Background" Value="{DynamicResource Mg.InsetBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Mg.LineBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Mg.LinkButton" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
  </ControlTheme>

  <!-- Круглая кнопка (3) под панелью: на фоне окна, поэтому цвета карточки. Класс .active — её панель открыта. -->
  <ControlTheme x:Key="Mg.RoundButton" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{DynamicResource Mg.SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Mg.LineBrush}" />
    </Style>
    <Style Selector="^.active">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.AccentBrush}" />
    </Style>
    <Style Selector="^.active /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.AccentBrush}" />
    </Style>
  </ControlTheme>


  <!--
    Элементы панелей: сегментный переключатель (Mg.Segment — RadioButton внутри Border.segments),
    строка списка (Mg.RowButton), кружок акцента (Mg.Swatch).
  -->

  <ControlTheme x:Key="Mg.Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Mg.FontCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="10">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource Mg.SurfaceBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Mg.RowButton" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Mg.InsetBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>
  </ControlTheme>

  <!-- Кружок акцента: содержимое (Ellipse) растягивается на всю кнопку за вычетом рамки и отступа. -->
  <ControlTheme x:Key="Mg.Swatch" TargetType="Button" BasedOn="{StaticResource Mg.ButtonBase}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.LineBrush}" />
    </Style>
    <Style Selector="^.selected /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
  </ControlTheme>


  <!--
    Переключатели с бегунком (controls:SlideSwitch). Положение бегунка, яркость краёв и слой «включено»
    задаёт сам контрол по ходу движения; здесь — только формы и цвета.
    Mg.ThemeSlider — широкая пилюля режима темы: дорожка как у сегментов, иконки краёв поверх бегунка.
    Mg.Toggle — маленький тумблер вкл/выкл: включённая дорожка — цвет акцента.
  -->

  <ControlTheme x:Key="Mg.ThemeSlider" TargetType="controls:SlideSwitch">
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource Mg.InsetBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    <Setter Property="InactiveOpacity" Value="0.45" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="22" />
          <Border x:Name="PART_Thumb" Width="36" Height="36" Margin="4" CornerRadius="18"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource Mg.SurfaceBrush}" BoxShadow="0 1 3 0 #40000000" />
          <ContentPresenter x:Name="PART_OffContent" Width="36" Height="36" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding OffContent}"
                            IsHitTestVisible="False" />
          <ContentPresenter x:Name="PART_OnContent" Width="36" Height="36" Margin="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding OnContent}"
                            IsHitTestVisible="False" />
          <Border x:Name="Ring" CornerRadius="22" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Mg.Toggle" TargetType="controls:SlideSwitch">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource Mg.InsetBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="13" />
          <Border x:Name="PART_OnLayer" Background="{DynamicResource Mg.AccentBrush}" CornerRadius="13" Opacity="0" />
          <Border x:Name="PART_Thumb" Width="20" Height="20" Margin="3" CornerRadius="10"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource Mg.SurfaceBrush}" BoxShadow="0 1 2 0 #40000000" />
          <Border x:Name="Ring" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
  </ControlTheme>

  <!-- Аватарка: инициалы — Onest, точка «в сети» — Mg.Online. Фон и цвет инициалов задаются при использовании. -->
  <ControlTheme x:Key="{x:Type controls:Avatar}" TargetType="controls:Avatar">
    <Setter Property="FontFamily" Value="{DynamicResource Mg.BodyFont}" />
    <Setter Property="OnlineBrush" Value="{DynamicResource Mg.OnlineBrush}" />
  </ControlTheme>

  <!--
    Счётчик непрочитанных (макет списка чатов): пилюля 22, скругление 11, Onest 12 SemiBold, по бокам 7.
    Kind: Accent — акцент, Muted — чат без звука, Mention — кружок «@». Класс small — счётчик на папке рейла.
  -->
  <ControlTheme x:Key="{x:Type controls:Badge}" TargetType="controls:Badge">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="FontFamily" Value="{DynamicResource Mg.BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Mg.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Mg.OnAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Text}"
                     Foreground="{TemplateBinding Foreground}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[Kind=Muted]">
      <Setter Property="Background" Value="{DynamicResource Mg.LineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
    <Style Selector="^[Kind=Mention]">
      <Setter Property="Text" Value="@" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="^.small[Kind=Mention]">
      <Setter Property="Width" Value="18" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
