<!--
  Свой заголовок окна. Пустое место — роль TitleBar (перетаскивание, двойной клик, прилипание к краям делает система).
  Кнопки помечены системными ролями — Windows считает их своими (в т.ч. меню раскладок у «Развернуть» на Windows 11).
  На macOS кнопки не показываются: остаются системные «светофоры» слева.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:l="using:MeowGram.Localization"
             xmlns:controls="using:MeowGram.Controls"
             x:Class="MeowGram.Controls.TitleBar"
             Height="{DynamicResource Mg.TitleBarHeight}">

  <UserControl.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="{DynamicResource Mg.TitleBarHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Background" Value="{DynamicResource Mg.LineBrush}" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Mg.LineBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Mg.ChromeCloseHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome controls|StrokeIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextMutedBrush}" />
    </Style>
    <Style Selector="Button.chrome:pointerover controls|StrokeIcon">
      <Setter Property="Foreground" Value="{DynamicResource Mg.TextBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover controls|StrokeIcon">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto">
    <Border x:Name="DragArea"
            Grid.ColumnSpan="2"
            Background="Transparent"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" />

    <StackPanel x:Name="WindowButtons" Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="MinimizeButton" Classes="chrome"
              chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
              ToolTip.Tip="{l:Tr Window_Minimize}"
              AutomationProperties.Name="{l:Tr Window_Minimize}">
        <controls:StrokeIcon Data="{StaticResource Icon.Minus}" />
      </Button>
      <Button x:Name="MaximizeButton" Classes="chrome"
              chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
              AutomationProperties.Name="{l:Tr Window_Maximize}">
        <controls:StrokeIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.Square}" />
      </Button>
      <Button x:Name="CloseButton" Classes="chrome close"
              chrome:WindowDecorationProperties.ElementRole="CloseButton"
              ToolTip.Tip="{l:Tr Window_Close}"
              AutomationProperties.Name="{l:Tr Window_Close}">
        <controls:StrokeIcon Data="{StaticResource Icon.X}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
