<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MeowGram.App"
             xmlns:local="using:MeowGram"
             RequestedThemeVariant="Dark">
  <!-- Тема по умолчанию — тёмная; реальную (из настроек) ставит ThemeService до показа окна. -->

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MeowGram/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://MeowGram/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MeowGram/Themes/BaseStyles.axaml" />
  </Application.Styles>
</Application>
